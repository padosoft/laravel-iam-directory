{
    "name": "padosoft/laravel-iam-directory",
    "description": "Modulo opzionale Directory di Laravel IAM: LDAP/Active Directory (LdapRecord) in v1; SCIM in v2.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "padosoft/laravel-iam-contracts": "*",
        "padosoft/laravel-iam-server": "*",
        "spatie/laravel-package-tools": "^1.16",
        "directorytree/ldaprecord-laravel": "^3.0"
    },
    "autoload": { "psr-4": { "Padosoft\\Iam\\Directory\\": "src/" } },
    "extra": { "branch-alias": { "dev-main": "0.1-dev" } },
    "minimum-stability": "dev",
    "prefer-stable": true
}
