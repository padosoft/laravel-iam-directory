  },
  "optionsMenu": {
    "position": "header",
    "components": { "search": true, "themeSwitch": true }
  },
  "theme": {
    "name": "default",
    "appearance": "dark",
    "customCss": []
  },
  "navigation": [
    { "text": "Home", "url": "/" },
    { "text": "Getting started", "url": "/getting-started" },
    { "text": "Concepts", "url": "/concepts" },
    { "text": "Provisioning & security", "url": "/provisioning-and-security" },
    { "text": "LDAP setup", "url": "/ldap-setup" },
    { "text": "Reference", "url": "/reference" }
  ],
  "plugins": {
    "search": {},
    "seo": { "titleTemplate": "%s | Laravel IAM Directory" },
    "sitemap": { "url": "https://padosoft.github.io/laravel-iam-directory" },
    "git": { "repo": "https://github.com/padosoft/laravel-iam-directory", "branch": "main", "editLink": true, "lastUpdated": true }
  }
